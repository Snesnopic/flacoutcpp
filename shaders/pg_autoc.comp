#version 450
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle    : require
//
// Pure-GPU encoder, stage 2: apodization window x autocorrelation, lags 0..32.
//
// One workgroup per (block, signal, window). The windowed block lives in shared
// memory for the whole reduction -- 4096 floats = 16 KB, which is why MAXB is
// 4096 and the host refuses a larger block size for this path.
//
// **fp32, deliberately.** The CPU path is double throughout and the project is
// built -ffp-contract=off because a last-bit difference flips which candidate
// wins. None of that applies here: everything upstream of the *integer*
// coefficients is a heuristic, and a worse heuristic costs compression, never
// losslessness. See PURE_GPU_PLAN.md.
//
// Two things keep fp32 honest anyway:
//
//  - **Samples are scaled to ~unit magnitude** (pc.scale = 2^-(bps-1)). LPC is
//    scale-invariant -- the Levinson recursion sees only ratios of
//    autocorrelation terms -- so this changes no decision, but it moves the
//    products from ~2^46 down to ~2^0 and stops the sum eating the mantissa.
//  - **The reduction is a tree, not a running sum.** Each lane folds B/LOCAL
//    terms, then subgroups fold, then one final pass over LOCAL/32 partials.
//    Error grows with the depth of the tree (~log B), not with B.

#define LOCAL 256
#define NLAG  33
// The block is walked in tiles rather than staged whole, so the block size is not
// bounded by shared memory. A tile carries a NLAG-1 halo because lag l needs
// x[i+l], and the halo is why each sample is read ~1.016 times rather than once.
// 4096 was the old ceiling (16 KB of floats); FLAC's real ceiling is 65535 and
// the DP-relevant sizes go to 16384.
#define TILE  2048
#define SHMEM (TILE + NLAG - 1)

layout(local_size_x = LOCAL) in;

layout(std430, binding = 0) readonly  buffer Sig   { int   sig[];   };
layout(std430, binding = 1) readonly  buffer Win   { float win[];   };
// Two floats per lag: the hi/lo pair of a double-float value.
layout(std430, binding = 2) writeonly buffer Autoc { vec2 autoc[]; };

layout(push_constant) uniform PC {
    int   nblk;
    int   bsize;
    int   nwin;
    float scale;    // 2^-(bps-1); see above
} pc;


// ---------------------------------------------------------------------------
// Double-float ("two-float") arithmetic: a hi/lo pair whose exact sum is the
// value, giving ~48 mantissa bits out of fp32 hardware.
//
// This is not a general precision upgrade -- it is aimed at one measured
// failure. The autocorrelation in plain fp32 is accurate to ~1e-7 relative
// (verified against a double host reference at every lag), which bounds the
// prediction gain the Levinson recursion can resolve at ~1e-7 of the signal
// energy. Real music sits at err/err0 ~ 4e-5, a 400x margin, and is unaffected.
// The side channel of highly-correlated tonal stereo reaches err/err0 ~ 1e-6:
// there the reflection coefficients past order ~5 are noise, |k| >= 1 fires, and
// the retry fills the higher orders with a worse predictor. Measured on one such
// block, order 32 cost *more* than order 8 and a 4th-order fixed predictor beat
// every LPC candidate (19356 bits against 24714).
//
// Upgrading the recursion alone does not work and was tried first: fed a noisy
// autocorrelation it faithfully solves the noisy problem, stops aborting, and
// loses the retry's accidental regularisation (syn3m_tonal got worse, 12610817
// -> 12722154). The autocorrelation and the recursion have to move together.
//
// twoSum and twoProd rely on the compiler not reassociating, which no GLSL or
// SPIR-V flag guarantees through MoltenVK's Metal path. Treated as empirical: if
// it were broken the tonal fixtures would not move.
// ---------------------------------------------------------------------------

// `precise` emits SPIR-V NoContraction, which forbids the compiler fusing and
// reassociating these expressions. Without it the error terms these two functions
// exist to compute are simply optimised away -- measured on Mesa ANV (Intel Arc),
// where the autocorrelation came out at 3e-8 instead of 3e-15, i.e. no better than
// plain fp32. Apple needed MVK_CONFIG_FAST_MATH_ENABLED=0 for the same reason;
// this is the portable form of that fix.
//
// **It is also expensive, and only where it is redundant does it pay to drop it.**
// On a driver that already leaves fp32 alone (Apple, with the MoltenVK fast-math
// knob off) NoContraction buys no accuracy and costs 5x in this kernel:
//
//   master mix, device timestamps    autoc 173.8 ms -> 33.8 ms, wall 0.260 -> 0.120 s
//   MLKDream                         autoc 110   ms -> 15.0 ms, wall 0.220 -> 0.130 s
//
// with **byte-identical output** on both, which is what says the two variants are
// the same computation there rather than a size/speed trade. So this file is
// compiled twice -- once as-is, once with PG_NO_PRECISE -- and the host picks
// between them by *probing the driver* (shaders/pg_probe.comp) rather than by
// recognising it. A driver that reassociates gets the safe variant; one that does
// not gets the fast one. See PureGpuEncoder::Impl::probeDoubleFloat.
#ifdef PG_NO_PRECISE
#define PRE
#else
#define PRE precise
#endif

PRE vec2 twoSum(float a, float b) {
    PRE float s  = a + b;
    PRE float bb = s - a;
    PRE float e  = (a - (s - bb)) + (b - bb);
    return vec2(s, e);
}

PRE vec2 twoProd(float a, float b) {
    PRE float p = a * b;
    PRE float e = fma(a, b, -p);
    return vec2(p, e);
}

PRE vec2 dfNorm(float hi, float lo) {
    PRE float t = hi + lo;
    PRE float e = lo - (t - hi);
    return vec2(t, e);
}

PRE vec2 dfAdd(vec2 a, vec2 b) {
    PRE vec2  s  = twoSum(a.x, b.x);
    PRE float lo = s.y + a.y + b.y;
    return dfNorm(s.x, lo);
}

vec2 dfNeg(vec2 a) { return vec2(-a.x, -a.y); }

PRE vec2 dfMul(vec2 a, vec2 b) {
    PRE vec2  p  = twoProd(a.x, b.x);
    PRE float lo = p.y + (a.x * b.y + a.y * b.x);
    return dfNorm(p.x, lo);
}

PRE vec2 dfDiv(vec2 a, vec2 b) {
    PRE float q1 = a.x / b.x;
    PRE vec2  r1 = dfAdd(a, dfNeg(dfMul(vec2(q1, 0.0), b)));
    PRE float q2 = r1.x / b.x;
    PRE vec2  r2 = dfAdd(r1, dfNeg(dfMul(vec2(q2, 0.0), b)));
    PRE float q3 = r2.x / b.x;
    PRE vec2  q  = twoSum(q1, q2);
    PRE float lo = q.y + q3;
    return dfNorm(q.x, lo);
}

shared float wnd[SHMEM];
shared vec2  part[(LOCAL / 32) * NLAG];

// Butterfly all-reduce over a hi/lo pair. subgroupAdd cannot be used: the two
// halves have to be combined together, not independently.
vec2 dfSubgroupAdd(vec2 v) {
    for (uint s = 1u; s < 32u; s <<= 1) {
        PRE vec2 o = vec2(subgroupShuffleXor(v.x, s), subgroupShuffleXor(v.y, s));
        v = dfAdd(v, o);
    }
    return v;
}

void main() {
    const int blk = int(gl_WorkGroupID.x);
    const int sgi = int(gl_WorkGroupID.y);
    const int w   = int(gl_WorkGroupID.z);
    const int B   = pc.bsize;
    const int t   = int(gl_LocalInvocationID.x);

    const int src = (sgi * pc.nblk + blk) * B;

    // The products are made exact by twoProd and the accumulation is exact to
    // ~48 bits, so what reaches Levinson is the autocorrelation of the fp32
    // windowed block rather than an approximation of it.
    vec2 acc[NLAG];
    for (int l = 0; l < NLAG; ++l) acc[l] = vec2(0.0);

    for (int t0 = 0; t0 < B; t0 += TILE) {
        const int have = min(SHMEM, B - t0);
        for (int i = t; i < have; i += LOCAL)
            wnd[i] = float(sig[src + t0 + i]) * pc.scale * win[w * B + t0 + i];
        barrier();

        const int lim = min(TILE, B - t0);
        for (int i = t; i < lim; i += LOCAL) {
            const float x = wnd[i];
            for (int l = 0; l < NLAG; ++l)
                if (t0 + i + l < B)
                    acc[l] = dfAdd(acc[l], twoProd(x, wnd[i + l]));
        }
        // Required before the next tile overwrites the staging area.
        barrier();
    }

    const uint sgid = gl_SubgroupID;
    for (int l = 0; l < NLAG; ++l) {
        const vec2 s = dfSubgroupAdd(acc[l]);
        if (subgroupElect()) part[sgid * NLAG + l] = s;
    }
    barrier();

    if (t < NLAG) {
        vec2 s = vec2(0.0);
        for (int k = 0; k < LOCAL / 32; ++k) s = dfAdd(s, part[k * NLAG + t]);
        const int idx = ((sgi * pc.nblk + blk) * pc.nwin + w);
        autoc[idx * NLAG + t] = s;
    }
}
